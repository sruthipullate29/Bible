{
  "name": "sharon-ag-desktop",
  "version": "0.1.0",
  "description": "Sharon AG – Bible Presentation Software with NIV & Telugu Bilingual Support",
  "main": "main.js",
  "author": "Sharon AG",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "church.sharonag.presentation",
    "productName": "Sharon AG",
    "copyright": "Copyright © 2024 Sharon AG",
    "directories": {
      "output": "../dist-electron",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "../apps/web/dist/**",
      "../apps/server/dev-server.mjs",
      "../apps/server/data/**",
      "../apps/server/scripts/**"
    ],
    "extraResources": [
      {
        "from": "../apps/server/data",
        "to": "server/data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sharon AG"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
